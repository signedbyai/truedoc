[
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "required": true,
    "default": "GET",
    "options": [
      { "label": "GET", "value": "GET" },
      { "label": "POST", "value": "POST" },
      { "label": "PUT", "value": "PUT" },
      { "label": "PATCH", "value": "PATCH" },
      { "label": "DELETE", "value": "DELETE" }
    ]
  },
  {
    "name": "url",
    "type": "text",
    "label": "URL",
    "required": true,
    "help": "Path relative to https://signedby.ai/api/v1 — e.g. /documents, /documents/abc123, or /documents?status=completed&limit=50. See the REST API docs for available endpoints."
  },
  {
    "name": "body",
    "type": "text",
    "label": "Body (raw JSON)",
    "required": false,
    "multiline": true,
    "help": "Optional. Raw JSON request body for POST/PUT/PATCH calls, e.g. {\"template_id\": \"...\", \"signer\": {\"email\": \"...\"}}. Leave blank for GET/DELETE."
  }
]
