{
  "url": "/documents",
  "qs": {
    "status": "declined",
    "limit": 100
  },
  "method": "GET",
  "response": {
    "output": "{{sort(body.documents, \"desc\", \"updated_at\")}}",
    "limit": "{{parameters.limit}}",
    "trigger": {
      "type": "date",
      "date": "{{parseDate(item.updated_at)}}"
    }
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 100}}"
    },
    "condition": "{{body.has_more}}"
  }
}
