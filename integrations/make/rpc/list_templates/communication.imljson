{
  "url": "/templates",
  "qs": {
    "limit": 100
  },
  "method": "GET",
  "response": {
    "iterate": "{{body.templates}}",
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}"
    }
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 100}}"
    },
    "condition": "{{body.has_more}}"
  }
}
